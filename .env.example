# config.py
## General
EMBY_SERVER = "http://127.0.0.1:8096"

# for 115
ENABLE_UA_PASSTHROUGH = false

IGNORE_PATH = "/mnt/localpath/, /mnt/localpath2/"

# 是否缓存视频前15秒用于起播加速
CACHE_ENABLE = false
CACHE_NEXT_EPISODE = false
CACHE_PATH = "/app/cache"

LOG_LEVEL = "INFO"

# 下面两项配置是为了处理挂载路径和 Raw Link Provider （Alist）路径不一致的情况
# 例如，在emby服务器中，视频路径是 /mnt/movie/xxx，但在alist中，视频路径是 /movie/xxx
# 则需要配置 mount_path_prefix_remove 为 /mnt，该程序会移除文件路径中的 /mnt 部分
# 同理，如果视频路径是 /movie/xxx，但在alist中，视频路径是 /mnt/movie/xxx，则需要配置 mount_path_prefix_add 为 /mnt
# 顺序是先移除，再添加
# 如果你100%确定挂载路径和Alist路径一致，可以忽略这两项配置
MOUNT_PATH_PREFIX_REMOVE = "/"
MOUNT_PATH_PREFIX_ADD = ""

RAW_LINK_PROVIDER = "alist" # alist or emby

ALIST_SERVER = "http://127.0.0.1:5244"
ALIST_API_KEY = ""

RAW_LINK_EMBY_SERVER = ""
RAW_LINK_EMBY_KEY = ""

# Experimental Config 试验性选项
## 强制打断连接（用于对range请求适配不佳的客户端）
FORCE_CLIENT_RECONNECT = true
## 仅使用内存缓存
MEMORY_CACHE_ONLY = false

# Advanced Config
# 非必要无需更改
## 1MB
# INITIAL_CACHE_SIZE_OF_TAIL = 1048576
## 200KB
# CHUNK_SIZE_OF_CHUNKSWITER = 204800

# HIGH_COMPAT_MEDIA_CLIENTS = "mpv, senplayer"

# Cache Cleanup Configuration 缓存清理配置
## 最大缓存大小(GB)，默认50GB
# CACHE_MAX_SIZE_GB = 50.0
## 缓存清理触发阈值，默认0.8（80%）
# CACHE_CLEANUP_THRESHOLD = 0.8
## 缓存清理目标，默认0.6（60%）
# CACHE_CLEANUP_TARGET = 0.6
## 最低分数阈值，低于此分数的缓存会被优先清理
# CACHE_MIN_SCORE_THRESHOLD = 200.0
## 缓存保护天数，最近N天访问的缓存不会被清理
# CACHE_PROTECTION_DAYS = 3
## 分数重新计算间隔（小时），默认24小时
# CACHE_SCORE_RECALC_HOURS = 24
## 缓存大小检查间隔（小时），默认1小时
# CACHE_SIZE_CHECK_HOURS = 1
## 是否启用每周定时清理，默认关闭（推荐关闭，缓存应该长期保留）
# CACHE_WEEKLY_CLEANUP = false